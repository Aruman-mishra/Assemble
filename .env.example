# These don't get read from a .env file on Vercel — you'll add them in
# Vercel dashboard → Project → Settings → Environment Variables instead.
# This file is just a reference for what's needed.

JWT_SECRET=replace-with-a-long-random-string

# From https://turso.tech (free tier)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# From https://aistudio.google.com/app/apikey (free tier)
GEMINI_API_KEY=
